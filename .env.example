# Application
APP_NAME="KPFU Web Assistant"
APP_ENV=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Storage (будет подключено на этапе 3)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# LLM (будет подключено на этапе 11)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval (будет подключено на этапе 10)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kpfu_documents

# Security (будет подключено на этапе 4)
JWT_SECRET_KEY=change-me-in-local-env
